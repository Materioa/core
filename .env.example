# Copy to `.env` and fill in real values. Never commit `.env`.
# Public (build-time, embedded by Vite — safe to expose in the client bundle):
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Cross-app SSO endpoints (optional overrides; defaults target production):
# PUBLIC_MATERIO_AUTH_URL=https://auth.getmaterio.app
# PUBLIC_MATERIO_ACCOUNTS_URL=https://accounts.getmaterio.app
# PUBLIC_MATERIO_ADMIN_URL=https://admin.getmaterio.app

# Server-only (never expose to client):
INSIGHTROOM_API=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
SITE_URL=
FRONTEND_URL=
API_BASE_URL=
GA4_PROPERTY_ID=
GA_SERVICE_ACCOUNT_KEY_BASE64=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_TOKEN=
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=

# Optional third dictionary provider (Google's "dictionaryextension-pa" endpoint).
# Server-only: never expose to the client. Leave GOOGLE_DICT_KEY unset to keep the
# keyless providers (dictionaryapi.dev + Wiktionary) as the only sources, which is
# the shipped default.
#
# This is an UNDOCUMENTED Google endpoint whose credential belongs to another
# product (the "Google Dictionary" Chrome extension). Its key is referrer-
# restricted, and that restriction is satisfied by an `x-referer` header carrying
# the extension's ID - there is no proof-of-possession, so treat this as borrowed
# and revocable at any time. Google can withdraw the key, the header value, or the
# whole endpoint without notice; the keyless providers stay in the race, so a
# revocation degrades answer quality rather than breaking lookups.
#
# GOOGLE_DICT_KEY=
# Only if Google rotates the extension ID; the code defaults to the current one.
# GOOGLE_DICT_X_REFERER=chrome-extension://mgijmajocgfcbeboacabfgobmjgjcoja
PORT=
MONGODB_URI=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SMTP_EMAIL=
SMTP_PASSWORD=
ALERT_EMAIL=
ALERT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
HF_TOKEN=
HF_LLM_URL=
HF_RERANKER_URL=
OIDC_PRIVATE_KEY_B64=
OIDC_PUBLIC_KEY=
OIDC_KEY_ID=
